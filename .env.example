# ─────────────────────────────────────────────────────────────────────────────
# Root .env — read by docker-compose only. Copy to .env and edit.
# Per-service env defaults live in frontend/.env.example and backend/.env.example.
# ─────────────────────────────────────────────────────────────────────────────

# ───── Compose project ─────
COMPOSE_PROJECT_NAME=cellready-ims

# ───── Postgres ─────
POSTGRES_USER=cellready
POSTGRES_PASSWORD=cellready_dev_only
POSTGRES_DB=cellready_ims
POSTGRES_HOST_PORT=5432

# ───── Backend ─────
BACKEND_HOST_PORT=8000
BACKEND_RELOAD=true
SUPERADMIN_EMAIL=admin@cellready.local
SUPERADMIN_PASSWORD=ChangeMe!Now123
SECRET_KEY=dev-only-change-in-prod-32-chars-min-aaaaaaaa
LOG_LEVEL=INFO
LOG_FORMAT=console

# ───── Frontend ─────
FRONTEND_HOST_PORT=3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/v1

# ───── MinIO (S3-compatible object store; AWS S3 in prod) ─────
# In dev the backend uses these to talk to the MinIO container.
# In prod: leave S3_ENDPOINT_URL unset (real S3), drop the root creds
# in favour of IAM role credentials, and point S3_SIGNATURES_BUCKET
# at a real bucket name owned by the deploy account.
MINIO_ROOT_USER=cellready
MINIO_ROOT_PASSWORD=cellready_dev_only
MINIO_API_HOST_PORT=9000
MINIO_CONSOLE_HOST_PORT=9001
S3_ENDPOINT_URL=http://minio:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=cellready
S3_SECRET_ACCESS_KEY=cellready_dev_only
S3_SIGNATURES_BUCKET=cellready-signatures
S3_FORCE_PATH_STYLE=true

# ───── Cognito (run scripts/seed_cognito.sh to populate IDs) ─────
AWS_REGION=us-east-1
COGNITO_HOST_PORT=9229
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
# Inside compose the backend reaches cognito on the docker network at cognito:9229
COGNITO_ENDPOINT_URL=http://cognito:9229
COGNITO_JWKS_URL=
# Token-issuer override (needed for cognito-local; leave unset for real Cognito)
COGNITO_ISSUER=

# ───── JWT / session TTLs ─────
# Drive the Cognito user pool client (applied by scripts/seed_cognito.sh) and
# the cookie max-ages used by the frontend BFF. Keep these in lockstep — if
# you change them, re-run the seed script so Cognito issues tokens with the
# new TTLs.
JWT_ACCESS_TOKEN_TTL_MINUTES=60
JWT_REFRESH_TOKEN_TTL_DAYS=30
JWT_ID_TOKEN_TTL_MINUTES=60
