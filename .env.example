# ─────────────────────────────────────────────────────────────────────────────
# Root .env — read by docker-compose only. Copy to .env and edit.
# Per-service env defaults live in frontend/.env.example and backend/.env.example.
#
# EVERY `REPLACE_ME_*` VALUE BELOW IS A PLACEHOLDER, NOT A CREDENTIAL.
# They are intentionally non-functional so that a copied-but-unedited file
# fails loudly instead of silently standing up services with a password that
# is published in this repository. docker-compose.yml uses `${VAR:?...}` for
# each of them, so an unset value stops the stack with a named error rather
# than falling back to a shared default.
#
# Nothing here is safe for staging or production: those environments take
# their secrets from SSM / Secrets Manager, never from a committed file.
# ─────────────────────────────────────────────────────────────────────────────

# ───── Compose project ─────
COMPOSE_PROJECT_NAME=cellready-ims

# ───── Postgres ─────
POSTGRES_USER=cellready
POSTGRES_PASSWORD=REPLACE_ME_local_only
POSTGRES_DB=cellready_ims
POSTGRES_HOST_PORT=5432

# ───── Backend ─────
BACKEND_HOST_PORT=8000
BACKEND_RELOAD=true
SECRET_KEY=REPLACE_ME_generate_with__python_-c_import_secrets_print_secrets.token_urlsafe_48

LOG_LEVEL=INFO
LOG_FORMAT=console

# ───── Frontend ─────
FRONTEND_HOST_PORT=3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/v1

# ───── Object storage: REMOVED 2026-08-03 ─────
# There is no MinIO / S3 configuration any more. Object storage held exactly
# one thing — the hand-drawn e-signature image — and that was removed when the
# client confirmed an electronic signature is the password re-authentication.
# If you have MINIO_* / S3_* left in a local .env, they are simply ignored.

# ───── Cognito (run scripts/seed_cognito.sh to populate IDs) ─────
AWS_REGION=us-east-1
COGNITO_HOST_PORT=9229
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
# Inside compose the backend reaches cognito on the docker network at cognito:9229
COGNITO_ENDPOINT_URL=http://cognito:9229
COGNITO_JWKS_URL=
# Token-issuer override (needed for cognito-local; leave unset for real Cognito)
COGNITO_ISSUER=

# ───── JWT / session TTLs ─────
# Drive the Cognito user pool client (applied by scripts/seed_cognito.sh) and
# the cookie max-ages used by the frontend BFF. Keep these in lockstep — if
# you change them, re-run the seed script so Cognito issues tokens with the
# new TTLs.
JWT_ACCESS_TOKEN_TTL_MINUTES=60
JWT_REFRESH_TOKEN_TTL_DAYS=30
JWT_ID_TOKEN_TTL_MINUTES=60

# ───── Invitations ─────
# Cognito emails the invitee a temporary password (delivered via Amazon SES when
# the User Pool is configured for it in prod). cognito-local can't send mail, so
# in dev the temp password is logged and shown in the admin UI. No SMTP config
# needed — the backend sends no email of its own.
FRONTEND_BASE_URL=http://localhost:3000
INVITE_TTL_DAYS=7
