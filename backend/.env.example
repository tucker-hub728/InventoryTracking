# ─────────────────────────────────────────────────────────────────────────────
# Backend env defaults. Copy to .env (gitignored) and edit if running natively.
# Inside Docker these are supplied by the root .env via docker-compose.yml.
# ─────────────────────────────────────────────────────────────────────────────

# App identity
APP_NAME=cellready-ims-backend
APP_ENV=development                  # development | staging | production
APP_DEBUG=true

# Server
HOST=0.0.0.0
PORT=8000

# Security
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=REPLACE_ME_generate_with_the_command_above

# JWT / session TTLs. These mirror the values configured on the Cognito user
# pool client by scripts/seed_cognito.sh and are echoed back to the frontend
# (BFF cookie max-ages, refresh scheduling).
JWT_ACCESS_TOKEN_TTL_MINUTES=60
JWT_ID_TOKEN_TTL_MINUTES=60
JWT_REFRESH_TOKEN_TTL_DAYS=30

# Invitations. Cognito emails the invitee a temporary password (delivered via
# Amazon SES when the User Pool is configured for it in prod); on first login
# they set a real password via the NEW_PASSWORD_REQUIRED challenge. cognito-local
# can't send mail, so in dev the temp password is logged and shown in the admin
# UI. The backend sends no email of its own — no SMTP config needed.
FRONTEND_BASE_URL=http://localhost:3000
INVITE_TTL_DAYS=7

# Database (async DSN — note the +asyncpg driver)
DATABASE_URL=postgresql+asyncpg://cellready:REPLACE_ME_local_only@postgres:5432/cellready_ims

# CORS — comma-separated list, no trailing slash
CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Logging
LOG_LEVEL=INFO                       # DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_FORMAT=console                   # console | json


# ─────────────────────────────────────────────────────────────────────────────
# AWS Cognito
# ─────────────────────────────────────────────────────────────────────────────
# Local dev points at cognito-local; production leaves COGNITO_ENDPOINT_URL
# unset so boto3 hits real Cognito.
#
# Both COGNITO_USER_POOL_ID and COGNITO_CLIENT_ID are produced by
# `./scripts/seed_cognito.sh`. Copy the output here and recreate the
# backend container (`docker compose up -d --force-recreate backend`).
# ─────────────────────────────────────────────────────────────────────────────
AWS_REGION=us-east-1
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
# When running natively: http://localhost:9229
# When running in compose (backend → cognito service): http://cognito:9229
COGNITO_ENDPOINT_URL=http://cognito:9229
# Optional override. If empty, derived from endpoint + pool id.
COGNITO_JWKS_URL=
# Override of the expected ``iss`` claim. Required for cognito-local (which
# hardcodes localhost in iss regardless of which host you call it from).
# Leave unset for real Cognito.
COGNITO_ISSUER=
