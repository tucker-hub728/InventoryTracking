# Public site configuration
NEXT_PUBLIC_APP_NAME="IMS"
NEXT_PUBLIC_APP_FULL_NAME="Inventory Management System"

# API base URL — used by the browser only as a fallback. Real auth traffic
# is proxied through the Next.js BFF routes under /api/auth, which talk to
# the backend over the server-side URL below.
NEXT_PUBLIC_API_BASE_URL="http://localhost:8000/v1"

# Server-side backend URL (NOT exposed to the browser). The BFF route
# handlers use this to reach the FastAPI service. Inside docker-compose
# this resolves to the `backend` service; for `npm run dev` against a
# host-run backend, use http://localhost:8000/v1.
BACKEND_INTERNAL_URL="http://backend:8000/v1"

# JWT / session TTLs. These must match what Cognito issues — keep them in
# sync with the root .env and re-run scripts/seed_cognito.sh if you change
# them.
JWT_ACCESS_TOKEN_TTL_MINUTES=60
JWT_REFRESH_TOKEN_TTL_DAYS=30

# Environment label shown in topbar (e.g. "21 CFR Part 11 environment · all actions are logged")
NEXT_PUBLIC_ENV_LABEL="21 CFR Part 11 environment · all actions are logged"
